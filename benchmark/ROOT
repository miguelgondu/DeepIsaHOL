chapter Benchmark

(*
  Union session for the theorem-proving benchmark.

  Building this session (see the Dockerfile) also builds and persists the heap
  images of every session it depends on, so the API can load any of them:

    HOL, HOL-Library, HOL-Computational_Algebra, HOL-Analysis, HOL-Probability,
    HOL-Number_Theory, HOL-Algebra, HOL-Combinatorics, HOL-Cardinals,
    HOL-Decision_Procs, HOL-Real_Asymp, HOL-Eisbach

  The `Benchmark` heap itself has the umbrella theory of each of those loaded, so
  a generated theory can `imports` any subset of them and it resolves instantly
  (no on-the-fly build). Keep the theory list to umbrellas + method-bearing
  Library theories; do not add one-off `HOL-Library` odds and ends here.
*)

session Benchmark = "HOL-Probability" +
  description
    "Analysis, probability, number theory, algebra, combinatorics, cardinals,
     plus the real_asymp / approximation / sos proof methods, in one heap."
  sessions
    "HOL-Number_Theory"
    "HOL-Algebra"
    "HOL-Combinatorics"
    "HOL-Cardinals"
    "HOL-Computational_Algebra"
    "HOL-Decision_Procs"
    "HOL-Real_Asymp"
    "HOL-Eisbach"
  theories
    "HOL-Number_Theory.Number_Theory"
    "HOL-Algebra.Algebra"
    "HOL-Combinatorics.Combinatorics"
    "HOL-Cardinals.Cardinals"
    "HOL-Computational_Algebra.Computational_Algebra"
    "HOL-Decision_Procs.Approximation"
    "HOL-Real_Asymp.Real_Asymp"
    "HOL-Eisbach.Eisbach"
    "HOL-Library.Sum_of_Squares"
    "HOL-Library.Quadratic_Discriminant"
    "HOL-Library.Code_Target_Numeral"
